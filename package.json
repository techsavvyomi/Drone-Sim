{
  "name": "drone-sim-game",
  "productName": "PlutoSim",
  "version": "0.1.0",
  "description": "PlutoSim: realistic drone flight simulator for STEM education and pilot training, by Drona Aviation",
  "author": "Drona Aviation",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "make:mac": "electron-forge make --platform=darwin --arch=arm64 && electron-forge make --platform=darwin --arch=x64",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:release": "npm run make:mac && npm run make:win && npm run verify:build",
    "make:icons": "node scripts/make-icons.mjs && node scripts/make-dmg-background.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/fuses": "^1.8.0",
    "@electron/get": "^5.1.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.1",
    "@reforged/maker-appimage": "^5.3.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "eslint": "^10.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.7",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "hls.js": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.5",
    "@react-three/rapier": {
      "@dimforge/rapier3d-compat": "$@dimforge/rapier3d-compat"
    }
  }
}
